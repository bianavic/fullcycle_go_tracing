# Copy to .env and fill in. docker compose reads .env automatically.
#   cp .env.example .env

# --- Required -----------------------------------------------------------------
# WeatherAPI key (https://www.weatherapi.com/). Used only by service-b and never logged.
WEATHER_API_KEY=your_weather_api_key_here

# --- Optional overrides (leave empty/commented to use the defaults) ------------
# Timeout for one call from service-a to service-b (default 15s: service-b makes two
# sequential upstream calls). Keep it above twice SERVICE_B_HTTP_CLIENT_TIMEOUT.
# SERVICE_A_HTTP_CLIENT_TIMEOUT=15s

# Timeout for each call from service-b to ViaCEP / WeatherAPI (default 5s).
# SERVICE_B_HTTP_CLIENT_TIMEOUT=5s

# External API base URLs (defaults: the public ViaCEP and WeatherAPI endpoints).
# VIACEP_BASE_URL=https://viacep.com.br/ws
# WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1/current.json
